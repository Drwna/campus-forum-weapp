# App
NODE_ENV=development
PORT=3001
API_BASE_PATH=/api/v1
APP_PUBLIC_URL=http://localhost:3001

# Database
DATABASE_URL=mysql://campus_forum:campus_forum_password@localhost:3306/campus_forum
TEST_DATABASE_URL=mysql://campus_forum:campus_forum_password@localhost:3306/campus_forum_test

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_ISSUER=campushub
JWT_AUDIENCE=campushub-users
JWT_EXPIRES_IN=7200
JWT_REFRESH_EXPIRES_IN=2592000
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=

# WeChat
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MOCK_ENABLED=true

# Uploads
UPLOAD_ROOT=./data/uploads
PUBLIC_UPLOAD_BASE_URL=/uploads
UPLOAD_MAX_IMAGE_SIZE_MB=5
UPLOAD_MAX_IMAGES_PER_POST=9

# Security and rate limit
RATE_LIMIT_USER_PER_MINUTE=60
RATE_LIMIT_IP_PER_MINUTE=200
RATE_LIMIT_POST_PER_MINUTE=5
BCRYPT_COST=10

# Observability
LOG_LEVEL=info
SENTRY_DSN=
